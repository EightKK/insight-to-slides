{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public data provenance and scope manifest",
  "type": "object",
  "required": ["schema_version", "observation_scope", "published_scope_label", "sources", "claims"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "observation_scope": {"enum": ["industry_aggregate", "company", "plant", "line", "sku", "customer_sku", "component"],
      "description": "Finest granularity actually observed in the public sources."},
    "published_scope_label": {"type": "string", "minLength": 3},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["url", "reference_period"],
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string", "pattern": "^https://"},
                     "reference_period": {"type": "string", "minLength": 4}}}},
    "disclosures": {"type": "object", "additionalProperties": {"enum": ["available", "partial", "unavailable"]},
      "description": "Dataset name -> disclosure status, e.g. bom, customer_item_profit."},
    "claims": {"type": "array", "items": {"type": "object", "required": ["type", "scope"],
      "properties": {
        "id": {"type": "string"},
        "text": {"type": "string"},
        "type": {"type": "string", "description": "observed, estimate, inference, scenario or advance (case-insensitive)"},
        "scope": {"enum": ["industry_aggregate", "company", "plant", "line", "sku", "customer_sku", "component"]},
        "source_url": {"type": "string"},
        "dataset": {"type": "string"},
        "represented_as": {"enum": ["confirmed_actual", "firm_order", "management_plan", "estimate", "scenario", "illustrative", "leading_indicator"]}}}}
  }
}
